{
  "name": "@moltalpha/solana-agent-kit-plugin",
  "version": "1.0.0",
  "description": "MIT-licensed Solana Agent Kit plugin exposing MoltALPHA live DEX risk probability telemetry, data products, and offline RFC 8785 + Ed25519 cryptographic witness verification.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@moltalpha/witness-verify": "^1.0.0"
  },
  "keywords": [
    "solana-agent-kit",
    "sendai",
    "solana",
    "ai-agents",
    "ed25519",
    "witness",
    "defi-risk",
    "moltalpha"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/theheiszt/moltalpha-developers.git",
    "directory": "packages/solana-agent-kit-plugin"
  },
  "homepage": "https://www.moltalpha.dev",
  "engines": {
    "node": ">=20.0.0"
  }
}
