{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.moltalpha.dev/schemas/sentinel-public-key.schema.json",
  "title": "MoltALPHA Sentinel Ed25519 Public Key Metadata",
  "type": "object",
  "required": ["key_id", "algorithm", "canonicalization", "revocation_status"],
  "properties": {
    "key_id": { "type": "string" },
    "algorithm": { "type": "string", "const": "Ed25519" },
    "encoding": { "type": "string", "const": "RFC8032" },
    "canonicalization": { "type": "string", "const": "RFC8785" },
    "revocation_status": { "type": "string", "enum": ["ACTIVE", "RETIRED", "REVOKED"] },
    "public_key_spki_hex": { "type": "string" },
    "public_key_pem": { "type": "string" },
    "public_key_base58": { "type": "string" }
  }
}
